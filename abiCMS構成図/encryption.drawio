                </mxCell>
                
                <!-- S3 암호화 -->
                <mxCell id="s3_encrypt_box" value="S3 버킷 암호화&lt;br&gt;&lt;font size=&quot;2&quot;&gt;암호화 방식: AES256&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;용도: CodePipeline 아티팩트&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;위치: terraform/modules/codepipeline/main.tf&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;설정: sse_algorithm = &quot;AES256&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
                    <mxGeometry x="740" y="610" width="280" height="150" as="geometry"/>
                </mxCell>
                
                <!-- Secrets Manager -->
                <mxCell id="secrets_box" value="AWS Secrets Manager&lt;br&gt;&lt;font size=&quot;2&quot;&gt;저장 항목:&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• DB 인증정보 (username, password)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• APP_KEY (Laravel 키)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• MAIL_PASSWORD&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;위치: terraform/modules/secrets/main.tf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
                    <mxGeometry x="1060" y="610" width="250" height="160" as="geometry"/>
                </mxCell>
                
                <!-- KMS -->
                <mxCell id="kms_box" value="KMS 복호화 권한&lt;br&gt;&lt;font size=&quot;2&quot;&gt;용도: Secrets Manager 접근&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;권한: kms:Decrypt&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;위치: terraform/modules/iam/main.tf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
                    <mxGeometry x="100" y="790" width="280" height="120" as="geometry"/>
