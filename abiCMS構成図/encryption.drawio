                <!-- 메일 TLS -->
                <mxCell id="mail_tls_box" value="메일 전송 암호화 (TLS)&lt;br&gt;&lt;font size=&quot;2&quot;&gt;암호화 방식: TLS&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;설정: MAIL_ENCRYPTION = &quot;tls&quot;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;위치: terraform/main.tf&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;포트: 587&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
                    <mxGeometry x="100" y="1160" width="280" height="120" as="geometry"/>
                </mxCell>
                
                <!-- 요약 영역 -->
                <mxCell id="summary_area" value="4. 암호화 요약 (Summary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="50" y="1350" width="1300" height="300" as="geometry"/>
                </mxCell>
                
                <mxCell id="summary_text" value="&lt;font size=&quot;3&quot;&gt;&lt;b&gt;총 11개 영역에서 암호화 적용&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;1. Laravel APP_KEY (AES-256-CBC)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;2. 데이터베이스 필드 암호화 (Encrypted Cast) - 3개 필드&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;3. 비밀번호 해싱 (Bcrypt)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;4. 쿠키 암호화 미들웨어&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;5. RDS 스토리지 암호화&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;6. ECR 이미지 암호화 (AES256)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;7. S3 버킷 암호화 (AES256)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;8. AWS Secrets Manager (3개 시크릿)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;9. KMS 복호화 권한&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;10. 메일 전송 암호화 (TLS)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;11. 세션 암호화 설정 (현재 비활성화)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#FF0000&quot;&gt;※ 참고: 세션 암호화는 현재 비활성화되어 있습니다. 필요시 SESSION_ENCRYPT=true로 변경하세요.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10" vertex="1" parent="1">
