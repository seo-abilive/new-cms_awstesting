                </mxCell>
                
                <!-- ECR 암호화 -->
                <mxCell id="ecr_encrypt_box" value="ECR 이미지 암호화&lt;br&gt;&lt;font size=&quot;2&quot;&gt;암호화 방식: AES256&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;위치: terraform/modules/ecr/main.tf&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;설정: encryption_type = &quot;AES256&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
