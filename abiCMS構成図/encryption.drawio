    <diagram id="encryption_diagram" name="암호화 설계도">
        <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
