                <!-- Laravel APP_KEY -->
                <mxCell id="app_key_box" value="Laravel APP_KEY&lt;br&gt;&lt;font size=&quot;2&quot;&gt;암호화 방식: AES-256-CBC&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;저장 위치: AWS Secrets Manager&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;용도: Laravel 암호화 서비스&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5" vertex="1" parent="1">
